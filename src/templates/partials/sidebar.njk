<aside class="sw-rail" id="sw-rail" aria-label="블로그 내비게이션">
  <div class="sw-brand">
    <div class="sw-monogram" aria-hidden="true">{{ site.initial }}</div>
    <div>
      <div class="name">{{ site.name }}</div>
      <div class="tag">{{ site.tagline }}</div>
    </div>
  </div>

  <form class="sw-search" role="search" onsubmit="return false">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    <label class="sw-sr" for="sw-search-input">검색</label>
    <input id="sw-search-input" name="q" placeholder="검색" autocomplete="off">
    <kbd>/</kbd>
  </form>

  <div class="sw-counts">
    <span>전체 <b>{{ site.counts.total }}</b></span>
    <span>오늘 <b>{{ site.counts.today }}</b></span>
    <span>어제 <b>{{ site.counts.yesterday }}</b></span>
  </div>

  <nav aria-label="카테고리">
    <div class="sw-nav-label">Categories</div>
    <div class="sw-cat">
      {% for c in site.categories %}
        {% if c.children %}
        <div>
          <button class="sw-cat-row" data-cat-toggle aria-expanded="false"><span class="twist" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 6 6 6-6 6"/></svg></span><span class="label">{{ c.label }}</span><span class="n">{{ c.count }}</span></button>
          <div class="sw-sub"><div class="sw-sub-inner">
            {% for s in c.children %}<a href="{{ s.url }}">{{ s.label }} <span class="n">{{ s.count }}</span></a>{% endfor %}
          </div></div>
        </div>
        {% else %}
        <a class="sw-cat-row{% if c.active %} active{% endif %}" href="{{ c.url }}"><span class="twist" aria-hidden="true"></span><span class="label">{{ c.label }}</span><span class="n">{{ c.count }}</span></a>
        {% endif %}
      {% endfor %}
    </div>
  </nav>

  <nav aria-label="블로그 메뉴">
    <div class="sw-nav-label">Menu</div>
    <div class="sw-menu">
      <a href="/"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>Home</a>
      <a href="{{ site.github }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-4 1.4-4-2.2-6-2.7m12 4.7v-3.6a3.1 3.1 0 0 0-.9-2.4c2.9-.3 6-1.4 6-6.4a5 5 0 0 0-1.4-3.4 4.6 4.6 0 0 0-.1-3.5s-1.1-.3-3.6 1.4a12.4 12.4 0 0 0-6.6 0C6.4 1.4 5.3 1.7 5.3 1.7a4.6 4.6 0 0 0-.1 3.5A5 5 0 0 0 3.8 8.6c0 5 3.1 6.1 6 6.4a3.1 3.1 0 0 0-.9 2.4V21"/></svg>GitHub</a>
      <a href="/about"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>About</a>
      <a href="/tag"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>Tags</a>
    </div>
  </nav>

  <div class="sw-rail-foot">
    <span>© {{ site.year }} {{ site.name }}</span>
    <span class="links">
      <a class="sw-icon-btn" href="/rss" aria-label="RSS"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/></svg></a>
      <a class="sw-icon-btn" href="{{ site.github }}" aria-label="GitHub"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-4 1.4-4-2.2-6-2.7m12 4.7v-3.6a3.1 3.1 0 0 0-.9-2.4c2.9-.3 6-1.4 6-6.4a5 5 0 0 0-1.4-3.4 4.6 4.6 0 0 0-.1-3.5s-1.1-.3-3.6 1.4a12.4 12.4 0 0 0-6.6 0C6.4 1.4 5.3 1.7 5.3 1.7a4.6 4.6 0 0 0-.1 3.5A5 5 0 0 0 3.8 8.6c0 5 3.1 6.1 6 6.4a3.1 3.1 0 0 0-.9 2.4V21"/></svg></a>
    </span>
  </div>
</aside>
