<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — {{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="stylesheet" href="./styles.css">
  <script>
    /* Set theme before first paint to avoid a flash. */
    (function(){try{var k="quiet-theme",s=localStorage.getItem(k),d=s?s==="dark":matchMedia("(prefers-color-scheme: dark)").matches;document.documentElement.setAttribute("data-theme",d?"dark":"light");}catch(e){}})();
  </script>
</head>
<body>
  <a class="quiet-skip" href="#quiet-main">Skip to content</a>
  <div id="quiet-progress"></div>
  <div class="quiet-shell">
    {% include "partials/sidebar.njk" %}
    <div class="quiet-scrim" id="quiet-scrim" hidden></div>
    <div class="quiet-content" id="quiet-main" tabindex="-1">
      {% include "partials/topbar.njk" %}
      {% block main %}{% endblock %}
      {% include "partials/footer.njk" %}
    </div>
  </div>
  {% include "partials/dock.njk" %}
  <script src="./app.js" defer></script>
</body>
</html>
