{% macro postRow(p) %}
<a class="quiet-post-row" href="{{ p.url }}">
  <time>{{ p.date }}</time>
  <div>
    <span class="cat" data-quiet-cat="{{ p.categoryUrl }}">{{ p.category }}</span>
    <h2>{{ p.title }}</h2>
    {% if p.summary %}<p>{{ p.summary }}</p>{% endif %}
  </div>
</a>
{% endmacro %}

{% macro comment(c) %}
<div class="quiet-comment{% if c.reply %} reply{% endif %}">
  <div class="av" aria-hidden="true">{{ c.initial }}</div>
  <div>
    <div><span class="who">{{ c.name }}</span><span class="when">{{ c.date }}</span></div>
    <div class="txt">{{ c.body }}</div>
    <div class="act" lang="en"><button type="button">Edit / Delete</button>{% if not c.reply %}<button type="button">Reply</button>{% endif %}</div>
  </div>
</div>
{% endmacro %}
