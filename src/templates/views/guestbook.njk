{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% block main %}
<main id="quiet-guestbook">
  <header class="quiet-article-head">
    <div class="cover" aria-hidden="true"></div>
    <div class="inner quiet-page-head">
      <a class="quiet-crumb" href="/">swarea</a>
      <h1>Guestbook</h1>
    </div>
  </header>
  <section class="quiet-comments" aria-label="Guestbook">
    <form class="quiet-cbox" onsubmit="return false">
      <label class="quiet-sr" for="quiet-guest-text">Write a guestbook entry</label>
      <textarea id="quiet-guest-text" placeholder="Leave a message"></textarea>
      <div class="cfields">
        <label class="quiet-sr" for="quiet-guest-name">Name</label><input id="quiet-guest-name" placeholder="Name" autocomplete="name">
        <label class="quiet-sr" for="quiet-guest-pw">Password</label><input id="quiet-guest-pw" type="password" placeholder="Password" autocomplete="off">
        <button type="submit" class="submit">Post</button>
      </div>
    </form>
    {% for c in guestbook %}{{ m.comment(c) }}{% endfor %}
  </section>
</main>
{% endblock %}
