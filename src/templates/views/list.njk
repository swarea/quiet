{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% block main %}
<main id="quiet-list">
  {# Both heads, as the skin emits them: the blogger's introduction is rendered
     on every list page and shown by CSS on the home page alone, so the mock has
     to carry it here too or the rule that hides it is never previewed. #}
  <header class="quiet-article-head">
    <div class="cover" aria-hidden="true"></div>
    <div class="inner quiet-intro">
      <div class="quiet-eyebrow">Learning in public</div>
      <h1>Ideas, carefully kept</h1>
      <p class="quiet-lede">A calm home for long-form notes.</p>
    </div>
    <div class="inner quiet-list-head">
      <h1>{{ list.title }}</h1>
      <p class="quiet-lede">{{ list.count }} posts</p>
    </div>
  </header>
  <div class="quiet-wrap">
    <section class="quiet-recent" aria-label="Posts">
      {% for p in list.posts %}{{ m.postRow(p) }}{% endfor %}
    </section>
    <nav class="quiet-paging" aria-label="Pagination">
      <span class="off" aria-hidden="true">‹</span>
      <a class="cur" href="#" aria-current="page">1</a>
      <a href="#">2</a>
      <a href="#">3</a>
      <a href="#">4</a>
      <span class="edge">…</span>
      <a href="#">18</a>
      <a href="#" aria-label="Next page">›</a>
    </nav>
  </div>
</main>
{% endblock %}
