{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% block main %}
<main id="sw-list">
  <header class="sw-article-head">
    <div class="cover" aria-hidden="true"></div>
    <div class="inner">
      <a class="sw-crumb" href="/">category</a>
      <h1>{{ list.title }}</h1>
      <div class="sw-byline"><span>{{ list.count }}개의 글</span></div>
    </div>
  </header>
  <div class="sw-wrap" style="padding-top:2rem;padding-bottom:2rem;">
    <section class="sw-recent" style="border-top:0;padding-top:0;" aria-label="글 목록">
      {% for p in list.posts %}{{ m.postRow(p) }}{% endfor %}
    </section>
  </div>
</main>
{% endblock %}
