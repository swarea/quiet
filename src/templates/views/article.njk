{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% block main %}
{% set a = article %}
<article id="sw-article">
  <header class="sw-article-head">
    <div class="cover" aria-hidden="true"></div>
    <div class="inner">
      <a class="sw-crumb" href="{{ a.categoryUrl }}">{{ a.crumb }}</a>
      <h1>{{ a.title }}</h1>
      <div class="sw-byline">
        <span>{{ a.date }}</span><span>{{ a.readtime }}</span><span>댓글 {{ a.comments }}</span>
        <span class="admin"><a href="#">수정</a> · <a href="#">삭제</a></span>
      </div>
    </div>
  </header>

  <div class="sw-article-body" id="sw-article-body">
    {{ a.body | safe }}
  </div>

  <div class="sw-article-foot">
    <div class="sw-tags">
      {% for t in a.tags %}<a href="/tag/{{ t }}">#{{ t }}</a>{% endfor %}
    </div>

    <div class="sw-author">
      <div class="sw-monogram" aria-hidden="true">{{ site.initial }}</div>
      <div><div class="n">{{ site.name }}</div><div class="b">{{ site.bio }}</div></div>
    </div>

    <nav class="sw-prevnext" aria-label="이전 다음 글">
      <a href="{{ a.prev.url }}"><div class="dir">← 이전 글</div><div class="t">{{ a.prev.title }}</div></a>
      <a class="next" href="{{ a.next.url }}"><div class="dir">다음 글 →</div><div class="t">{{ a.next.title }}</div></a>
    </nav>

    <div class="sw-related">
      <div class="sw-section-tag"><h2>'{{ a.categoryName }}' 카테고리의 다른 글</h2></div>
      <ul>
        {% for r in a.related %}<li><a href="{{ r.url }}"><span>{{ r.title }}</span><time>{{ r.date }}</time></a></li>{% endfor %}
      </ul>
    </div>
  </div>

  <section class="sw-comments" aria-label="댓글">
    <div class="sw-section-tag"><h2>댓글 {{ a.comments }}</h2></div>
    <form class="sw-cbox" onsubmit="return false">
      <label class="sw-sr" for="sw-comment">댓글 입력</label>
      <textarea id="sw-comment" placeholder="댓글을 남겨주세요"></textarea>
      <div class="cfields">
        <label class="sw-sr" for="sw-cname">이름</label><input id="sw-cname" placeholder="이름" autocomplete="name">
        <label class="sw-sr" for="sw-cpw">비밀번호</label><input id="sw-cpw" type="password" placeholder="비밀번호" autocomplete="off">
        <button type="submit" class="submit">등록</button>
      </div>
    </form>
    {% for c in a.commentList %}{{ m.comment(c) }}{% endfor %}
  </section>
</article>
{% endblock %}
