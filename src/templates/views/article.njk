{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% block main %}
{% set a = article %}
<main>
<article id="quiet-article">
  <header class="quiet-article-head">
    <div class="cover" aria-hidden="true"></div>
    <div class="inner">
      <a class="quiet-crumb" href="{{ a.categoryUrl }}" data-quiet-cat="{{ a.categoryUrl }}">{{ a.crumb }}</a>
      <h1>{{ a.title }}</h1>
      <div class="quiet-byline">
        <span>{{ a.date }}</span><span>{{ a.readtime }}</span><span>Comments {{ a.comments }}</span>
        <span class="admin"><a href="#">Edit</a> · <a href="#">Delete</a></span>
      </div>
    </div>
  </header>

  <div class="quiet-article-body">
    {{ a.body | safe }}
  </div>

  <div class="quiet-article-foot">
    <div class="quiet-tags">
      {% for t in a.tags %}<a href="/tag/{{ t }}">#{{ t }}</a>{% endfor %}
    </div>

    <div class="quiet-related">
      <div class="quiet-section-tag"><h2>More in '{{ a.categoryName }}'</h2></div>
      <ul>
        {% for r in a.related %}<li><a href="{{ r.url }}"><span>{{ r.title }}</span><time>{{ r.date }}</time></a></li>{% endfor %}
      </ul>
    </div>

    <div class="quiet-author">
      <div class="quiet-monogram" aria-hidden="true">{{ site.initial }}</div>
      <div><div class="n">{{ site.name }}</div><div class="b">{{ site.bio }}</div></div>
    </div>
  </div>

  <section class="quiet-comments" aria-label="Comments">
    <div class="quiet-section-tag"><h2>Comments {{ a.comments }}</h2></div>
    <form class="quiet-cbox" onsubmit="return false">
      <label class="quiet-sr" for="quiet-comment">Leave a comment</label>
      <textarea id="quiet-comment" placeholder="Leave a comment"></textarea>
      <div class="cfields">
        <label class="quiet-sr" for="quiet-cname">Name</label><input id="quiet-cname" placeholder="Name" autocomplete="name">
        <label class="quiet-sr" for="quiet-cpw">Password</label><input id="quiet-cpw" type="password" placeholder="Password" autocomplete="off">
        <button type="submit" class="submit">Post</button>
      </div>
    </form>
    {% for c in a.commentList %}{{ m.comment(c) }}{% endfor %}
  </section>
</article>
</main>
{% endblock %}
