{% extends "layout.njk" %}
{% block main %}
<main id="quiet-tag">
  <header class="quiet-article-head">
    <div class="cover" aria-hidden="true"></div>
    <div class="inner quiet-page-head">
      <a class="quiet-crumb" href="/">swarea</a>
      <h1>Tags</h1>
      <div class="quiet-byline"><span>{{ tags.length }} tags</span></div>
    </div>
  </header>
  <div class="quiet-wrap">
    <section class="quiet-tagcloud" aria-label="Tags">
      <ul>
        {% for t in tags %}
        <li><a href="/tag/{{ t.name }}"><span class="name">{{ t.name }}</span><span class="n">{{ t.count }}</span></a></li>
        {% endfor %}
      </ul>
    </section>
  </div>
</main>
{% endblock %}
