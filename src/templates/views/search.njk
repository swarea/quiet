{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% block main %}
<main id="quiet-search-view">
  <header class="quiet-article-head">
    <div class="cover" aria-hidden="true"></div>
    <div class="inner">
      <a class="quiet-crumb" href="/">Search</a>
      <h1>&lsquo;{{ search.query }}&rsquo; Search results</h1>
      <div class="quiet-byline"><span>{{ search.results.length }} posts</span></div>
    </div>
  </header>
  <div class="quiet-wrap">
    {% if search.results.length %}
    <section class="quiet-recent" style="border-top:0;padding-top:2rem;" aria-label="Search results">
      {% for p in search.results %}{{ m.postRow(p) }}{% endfor %}
    </section>
    {% else %}
    <div class="quiet-empty">
      <div class="glyph" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></div>
      <h2>No results</h2>
      <p><q>{{ search.query }}</q> turned up nothing. Try a different search term.</p>
    </div>
    {% endif %}
  </div>
</main>
{% endblock %}
