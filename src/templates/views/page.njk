{% extends "layout.njk" %}
{% block main %}
<article id="sw-page">
  <header class="sw-article-head">
    <div class="cover" aria-hidden="true"></div>
    <div class="inner">
      <h1>{{ page.title }}</h1>
    </div>
  </header>
  <div class="sw-article-body" id="sw-page-body">
    {{ page.body | safe }}
  </div>
  <div style="height:2.5rem"></div>
</article>
{% endblock %}
