{% extends "layout.njk" %}
{% block main %}
<main id="sw-protected-view">
  <div class="sw-protected">
    <div class="lock" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div>
    <h1>보호되어 있는 글입니다</h1>
    <p>내용을 보시려면 비밀번호를 입력하세요.</p>
    <form onsubmit="return false">
      <label for="sw-pw">비밀번호</label>
      <input id="sw-pw" type="password" maxlength="16" placeholder="비밀번호" autocomplete="off">
      <button type="submit">확인</button>
    </form>
  </div>
</main>
{% endblock %}
