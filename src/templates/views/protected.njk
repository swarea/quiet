{% extends "layout.njk" %}
{% block main %}
<main id="quiet-protected-view">
  <div class="quiet-protected">
    <div class="lock" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div>
    <h1>This post is protected</h1>
    <p>Enter the password to read this post.</p>
    <form onsubmit="return false">
      <label for="quiet-pw">Password</label>
      <input id="quiet-pw" type="password" maxlength="16" placeholder="Password" autocomplete="off">
      <button type="submit">Unlock</button>
    </form>
  </div>
</main>
{% endblock %}
