{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% block main %}
<main class="quiet-wrap" id="quiet-home">
  <section class="quiet-intro quiet-load">
    <div class="quiet-eyebrow">Learning in public</div>
    <h1>{{ home.headline | safe }}</h1>
    <p>{{ home.subtitle }}</p>
  </section>

  {% set f = home.featured %}
  <section class="quiet-featured quiet-reveal" aria-label="Featured">
    <div class="txt">
      <span class="cat">{{ f.category }}</span>
      <h3><a href="{{ f.url }}">{{ f.title }}</a></h3>
      <p>{{ f.summary }}</p>
      <div class="meta"><span>{{ f.date }}</span><span>{{ f.readtime }}</span><span>Comments {{ f.comments }}</span></div>
    </div>
    <div class="cover" aria-hidden="true">Cover image (optional)</div>
  </section>

  <section class="quiet-recent quiet-reveal" aria-label="Recent posts">
    <div class="quiet-section-tag"><h2>Recent</h2><a href="/">All posts →</a></div>
    {% for p in home.recent %}{{ m.postRow(p) }}{% endfor %}
  </section>

  <section class="quiet-topics quiet-reveal" aria-label="Topics">
    <div class="quiet-section-tag"><h2>Topics</h2></div>
    <div class="quiet-lanes">
      {% for lane in home.topics %}
      <div class="quiet-lane">
        <h3>{{ lane.title }}</h3>
        {% for item in lane.items %}<a class="item" href="{{ item.url }}">{{ item.title }}</a>{% endfor %}
      </div>
      {% endfor %}
    </div>
  </section>
</main>
{% endblock %}
