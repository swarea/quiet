{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% block main %}
<main class="sw-wrap" id="sw-home">
  <section class="sw-intro sw-load">
    <div class="sw-eyebrow">{{ site.name }} — Learning in public</div>
    <h1>{{ home.headline | safe }}</h1>
    <p>{{ home.subtitle }}</p>
  </section>

  {% set f = home.featured %}
  <section class="sw-featured sw-reveal" aria-label="추천 글">
    <div class="txt">
      <span class="cat">{{ f.category }}</span>
      <h3><a href="{{ f.url }}">{{ f.title }}</a></h3>
      <p>{{ f.summary }}</p>
      <div class="meta"><span>{{ f.date }}</span><span>{{ f.readtime }}</span><span>댓글 {{ f.comments }}</span></div>
    </div>
    <div class="cover" aria-hidden="true">대표 이미지 (선택)</div>
  </section>

  <section class="sw-recent sw-reveal" aria-label="최근 글">
    <div class="sw-section-tag"><h2>Recent</h2><a href="/">전체 글 →</a></div>
    {% for p in home.recent %}{{ m.postRow(p) }}{% endfor %}
  </section>

  <section class="sw-topics sw-reveal" aria-label="주제">
    <div class="sw-section-tag"><h2>Topics</h2></div>
    <div class="sw-lanes">
      {% for lane in home.topics %}
      <div class="sw-lane">
        <h3>{{ lane.title }}</h3>
        {% for item in lane.items %}<a class="item" href="{{ item.url }}">{{ item.title }}</a>{% endfor %}
      </div>
      {% endfor %}
    </div>
  </section>
</main>
{% endblock %}
