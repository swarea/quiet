<?xml version="1.0" encoding="utf-8"?>
<!--
  Tistory skin metadata and settings.
  Element names follow the official skin guide exactly; do not invent elements,
  Tistory rejects the file outright. Changing this file resets a blog's saved
  skin settings, so keep variable names stable across versions.
-->
<skin>
  <information>
    <name>Quiet</name>
    <version>0.2.1</version>
    <description>
      <![CDATA[글이 잘 읽히도록 여백과 글자 크기를 맞춘 티스토리 스킨입니다. 라이트와 다크를 각각 설계했고, 목차·카테고리 접기·코드 복사·이미지 확대를 지원합니다. 티스토리가 넣는 댓글창과 공감·공유 버튼까지 같은 톤으로 맞췄습니다. 스크립트가 꺼져도 글과 메뉴, 카테고리 이동은 그대로 동작합니다.]]>
    </description>
    <license>
      <![CDATA[MIT License. 자유롭게 사용·수정·재배포할 수 있으며, 저작권 고지만 유지하면 됩니다. https://github.com/swarea/quiet]]>
    </license>
  </information>
  <author>
    <name>swarea</name>
    <homepage>https://github.com/swarea</homepage>
    <email></email>
  </author>
  <default>
    <recentEntries>5</recentEntries>
    <recentComments>5</recentComments>
    <recentTrackbacks>0</recentTrackbacks>
    <itemsOnGuestbook>10</itemsOnGuestbook>
    <tagsInCloud>30</tagsInCloud>
    <sortInCloud>3</sortInCloud>
    <expandComment>1</expandComment>
    <expandTrackback>0</expandTrackback>
    <lengthOfRecentNotice>28</lengthOfRecentNotice>
    <lengthOfRecentEntry>28</lengthOfRecentEntry>
    <lengthOfRecentComment>30</lengthOfRecentComment>
    <lengthOfRecentTrackback>30</lengthOfRecentTrackback>
    <lengthOfLink>30</lengthOfLink>
    <showListOnCategory>1</showListOnCategory>
    <showListOnArchive>1</showListOnArchive>
    <commentMessage>
      <none>댓글이 없습니다.</none>
      <single>댓글 &lt;span class="cnt"&gt;하나&lt;/span&gt; 달렸습니다.</single>
    </commentMessage>
    <trackbackMessage>
      <none>트랙백이 없습니다.</none>
      <single>트랙백이 &lt;span class="cnt"&gt;하나&lt;/span&gt; 달렸습니다.</single>
    </trackbackMessage>
    <tree>
      <color>565b62</color>
      <bgColor></bgColor>
      <activeColor>38548c</activeColor>
      <activeBgColor>eef1f7</activeBgColor>
      <labelLength>28</labelLength>
      <showValue>1</showValue>
    </tree>
    <contentWidth>800</contentWidth>
  </default>
  <cover>
    <item>
      <name>masthead</name>
      <label><![CDATA[소개]]></label>
      <description><![CDATA[홈 맨 위에 놓일 소개말입니다. 콘텐츠를 '직접 입력'으로 두고 글을 하나만 추가하세요. 커버 타이틀은 그 위에 작게, 글 제목은 크게, 내용은 그 아래에 놓입니다.]]></description>
    </item>
    <item>
      <name>list</name>
      <label><![CDATA[리스트]]></label>
      <description><![CDATA[글을 한 줄씩 목록으로 보여줍니다.]]></description>
    </item>
    <item>
      <name>featured</name>
      <label><![CDATA[대표 글]]></label>
      <description><![CDATA[글 몇 개를 큰 카드로 앞세웁니다. 홈을 목록이 아니라 입구로 만들 때 씁니다.]]></description>
    </item>
    <item>
      <name>grid</name>
      <label><![CDATA[주제 묶음]]></label>
      <description><![CDATA[글을 카테고리별 묶음으로 보여줍니다.]]></description>
    </item>
  </cover>
  <variables>
    <variablegroup name="레이아웃">
      <variable>
        <name>sidebar</name>
        <label><![CDATA[사이드바 사용]]></label>
        <description><![CDATA[왼쪽 사이드바를 표시합니다.]]></description>
        <type>BOOL</type>
        <default>true</default>
      </variable>
      <variable>
        <name>toc</name>
        <label><![CDATA[목차 사용]]></label>
        <description><![CDATA[글에 제목이 있을 때만 자동으로 표시됩니다.]]></description>
        <type>BOOL</type>
        <default>true</default>
      </variable>
      <variable>
        <name>reading-progress</name>
        <label><![CDATA[읽기 진행률 표시]]></label>
        <description><![CDATA[화면 상단에 읽은 비율을 얇은 막대로 표시합니다.]]></description>
        <type>BOOL</type>
        <default>true</default>
      </variable>
      <variable>
        <name>home-eyebrow</name>
        <label><![CDATA[홈 소개 머리말]]></label>
        <description><![CDATA[소개 문구 위에 작게 놓일 한 마디입니다. 짧을수록 좋고, 비워두면 나오지 않습니다.]]></description>
        <type>STRING</type>
        <default><![CDATA[]]></default>
      </variable>
      <variable>
        <name>home-headline</name>
        <label><![CDATA[홈 소개 문구]]></label>
        <description><![CDATA[홈 맨 위에 크게 놓일 한 줄입니다. 비워두면 글 목록 제목이 그대로 나옵니다.]]></description>
        <type>STRING</type>
        <default><![CDATA[]]></default>
      </variable>
      <variable>
        <name>home-tagline</name>
        <label><![CDATA[홈 소개 설명]]></label>
        <description><![CDATA[소개 문구 아래에 놓일 한 줄입니다. 소개 문구를 채운 경우에만 보입니다.]]></description>
        <type>STRING</type>
        <default><![CDATA[]]></default>
      </variable>
      <variable>
        <name>accent-light</name>
        <label><![CDATA[강조색 (라이트)]]></label>
        <description><![CDATA[링크와 강조에 쓰이는 색입니다. 밝은 배경에서 읽히는 색으로 고르세요.]]></description>
        <type>COLOR</type>
        <default>#38548c</default>
      </variable>
      <variable>
        <name>accent-dark</name>
        <label><![CDATA[강조색 (다크)]]></label>
        <description><![CDATA[다크 모드에서 쓰이는 강조색입니다. 어두운 배경에서 읽히는 밝은 색으로 고르세요.]]></description>
        <type>COLOR</type>
        <default>#90a8e0</default>
      </variable>
      <variable>
        <name>theme</name>
        <label><![CDATA[기본 테마]]></label>
        <description><![CDATA[처음 방문한 독자에게 보여줄 테마입니다. 독자가 직접 바꾸면 그 선택이 우선합니다.]]></description>
        <type>SELECT</type>
        <option>[{"name":"system","label":"방문자 설정 따름","value":"system"},{"name":"light","label":"라이트","value":"light"},{"name":"dark","label":"다크","value":"dark"}]</option>
        <default>system</default>
      </variable>
      <variable>
        <name>prev-next</name>
        <label><![CDATA[이전·다음 글 표시]]></label>
        <description><![CDATA[글 하단에 바로 앞뒤 순서의 글로 이동하는 링크를 보여줍니다.]]></description>
        <type>BOOL</type>
        <default>false</default>
      </variable>
      <variable>
        <name>related-posts</name>
        <label><![CDATA[관련 글 표시]]></label>
        <description><![CDATA[글 하단에 같은 카테고리의 다른 글을 보여줍니다.]]></description>
        <type>BOOL</type>
        <default>true</default>
      </variable>
    </variablegroup>
  </variables>
</skin>
